# ==========================================================
# 1. 大模型接口（必填）
# ==========================================================
# 申请地址：https://platform.deepseek.com/api_keys
OPENAI_API_KEY=

# DeepSeek 官方地址；换别的中转/模型时改这两行即可
OPENAI_BASE_URL=
OPENAI_MODEL=

# ==========================================================
# 2. 你的个人信息（会写进打招呼语结尾）
# ==========================================================
CANDIDATE_NAME=
# 英文场景（LinkedIn / 海外投递 / 博士套磁）用的拼音名
CANDIDATE_NAME_EN=
CANDIDATE_CONTACT=

# 话术场景（也可用命令行 --scene 临时覆盖）
#   zh_job   BOSS直聘打招呼（中文）
#   en_cover LinkedIn Easy Apply 求职信（英文）
#   en_note  LinkedIn 加好友备注（英文，300字符硬限）
#   en_phd   博士申请套磁邮件（英文）
LETTER_SCENE=

# 英文简历目录名（放 resume_en/ 下，投领英时用；没有则回退中文简历）
# 英文简历请放到 auto_job_find/resume_en/

# ==========================================================
# 3. 投递参数
# ==========================================================
# 目标页面：默认是「推荐职位」。想定向投递可换成搜索结果页，例如
#   https://www.zhipin.com/web/geek/job?query=产品经理&city=101280600
# 与简历对口的岗位方向（按自己的求职方向改，例如「产品经理」）
# ⚠ 路径是 jobs（复数），写成 job（单数）会 0 结果。城市码：温州=101210700，全国=100010000
JOB_URL=

# 期望职位筛选标签，页面上没有这个标签时会自动跳过。留空 = 不筛选
EXPECT_LABEL=

BROWSER=

# 1 = 直接用你日常 Edge 的用户数据目录（脚本会新开一个窗口；需先关闭日常 Edge 窗口，
#     否则目录被占用会自动回退到 edge_profile 复制版）
# 实测注意：默认目录下 Chromium 会忽略远程调试端口，半自动模式用不到调试端口，无影响
EDGE_USE_DEFAULT_PROFILE=

# 本轮最多投递几个，建议别一次太多，容易被平台风控
MAX_APPLY=
# 最多扫多少个列表项（含跳过的）
MAX_SCAN=
# 打招呼语字数上限
LETTER_LIMIT=

# 0 = 真实发送；1 = 只生成文案；2 = 演练（打开聊天框填好文字并截图，但不按回车发送）
DRY_RUN=

# 1 = 保存登录态到 chrome_profile/，第二次运行不用再扫码；0 = 每次都开全新浏览器
PERSIST_PROFILE=

# 1 = 接入你手动打开的浏览器；0 = 脚本自己开浏览器（用这个）
ATTACH_MODE=
# 调试端口（ATTACH_MODE=1 时用）
ATTACH_PORT=
# 固定复用端口：脚本自己开的浏览器也带这个端口，下次运行优先接入它，
# 从而永远复用同一个窗口 —— 不再反复开新窗口、不再重复刷新
REUSE_PORT=

# 跑完后是否保持浏览器打开等待人工确认。1 = 挂起等待，不关浏览器
# （脚本一退出浏览器就会被回收，想人工介入时必须开着）
HOLD_BROWSER=
# 等待人工完成「安全验证 + 登录」的秒数
LOGIN_WAIT=

# ==========================================================
# 4. 岗位筛选（matcher.py 用；油猴脚本的「自动筛选投递」靠这些）
# ==========================================================
# 判定门槛：规则打分达到多少分才投。分数越高越保守
#   60 = 默认（推荐）；75 = 很挑；45 = 投得宽一些
MATCH_THRESHOLD=

# 你自己加的排除词（逗号分隔）。命中「岗位标题或公司名」直接跳过。
# ⚠ 只会拿标题和公司名去匹配，不匹配 JD 正文和卡片全文 ——
#    否则 BOSS 卡片福利标签里的「股票期权」「培训」会把正经研发岗误杀。
# （内置的排除词表在 matcher.py 里，这里只是给你临时补充用）
EXCLUDE_KEYWORDS=

# 目标关键词（逗号分隔）。留空 = 不按词筛（推荐留空）。
# ⚠ 一旦填了，就变成「一个都没命中就重扣分」的门槛；而领英的 JD 是英文，
#    填中文关键词会导致英文岗位全被扣分。要填就中英都写。
INCLUDE_KEYWORDS=

# 1 = 需要雇主提供签证赞助 → 写明「不提供 sponsorship / 需本地工作许可」的岗位会被重扣分
# 0 = 不需要（或者只投国内/本地岗位）
NEED_VISA=

# ==========================================================================
# 4b. 候选人资质应答（Easy Apply 自动填表用，务必如实填写）
# ==========================================================================
# 1 = 自动如实回答签证/工作许可/国籍类筛查题；0 = 一律退回人工（最保守、最慢）
# 说明：这些题的答案本来就是你给的事实，脚本只是照实勾选，不会替你编。
#   一旦 .env 里没写清 / 题目对不上已知类别，仍会退回人工，绝不瞎填。
AUTO_ANSWER_SCREENING=
# 是否现在或将来需要雇主提供签证/工作许可赞助（"require sponsorship?" → 勾 Yes）
ANS_REQUIRE_SPONSORSHIP=
# 是否已在目标国拥有合法工作授权（"authorized to work?" → 勾 No，但会注明需要赞助）
ANS_AUTHORIZED=
# 国籍（填国籍题用；"are you a citizen of X?" → 勾 No）
ANS_NATIONALITY=

# 目标工作地点（逗号分隔）。上面 NEED_VISA=1 表示投海外，但到底投哪些国家
# 还没定，先留空 = 不限。确定后请填，例如：United States,United Kingdom,
# Germany,Singapore,Switzerland,Canada,Australia
TARGET_REGIONS=

# ==========================================================
# 5. 半自动投递（semi_auto.py 老路线，现在主要走油猴脚本）
# ==========================================================
# 每天最多真实发送几条（安全上限，宁少勿多）
DAILY_CAP=
# 两条话术之间的随机等待区间（秒）
SEND_MIN_INTERVAL=
SEND_MAX_INTERVAL=

